# NEVER commit real secrets. This file is an example only.
# Deployment secrets must live in a protected backend / STS / env, never in the repo or public site.

# Protected deployment service (server/deployment-service) reads these — never the browser:
DEPLOY_SERVICE_URL=http://localhost:8787
DEPLOY_SERVICE_TOKEN=replace-with-long-random-token
DEPLOY_ALLOW_UNSIGNED=false

# AWS is resolved server-side via STS / IAM role. Do NOT put keys in the CMS UI.
# AWS_REGION=ap-south-1
# DEPLOYMENT_PROFILE_PATH=./deployment-profile.json
